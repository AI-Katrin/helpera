# Скопировать в /var/www/helpera/.env на сервере и заполнить значения

PORT=3000

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Yandex Cloud (ML / LLM)
YANDEX_CLOUD_API_KEY=AQVN...
YANDEX_CLOUD_FOLDER=b1g...
YANDEX_CLOUD_MODEL=yandexgpt-lite/latest

# VK ID OAuth
VK_CLIENT_ID=54612071
VK_CLIENT_SECRET=

# Yandex OAuth
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# Безопасность
HELPERA_OAUTH_SALT=замените-на-случайную-строку-минимум-32-символа
HELPERA_BASE_URL=https://helpera.ru

# Настройки платформы (опционально)
HELPERA_NGO_TASK_LIMIT=10
HELPERA_APPLICATION_TIMEOUT_DAYS=7
HELPERA_NGO_RESPONSE_TIMEOUT_HOURS=72
