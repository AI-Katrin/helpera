YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_MODEL="yandexgpt-lite/latest"

# VK OAuth (https://vk.com/apps?act=manage)
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Yandex OAuth (https://oauth.yandex.ru/client/new)
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# OAuth settings
# Обязательно: случайная строка >= 32 символов. Сгенерируйте: python3 -c "import secrets; print(secrets.token_hex(32))"
HELPERA_OAUTH_SALT=
HELPERA_BASE_URL=http://localhost:3000
